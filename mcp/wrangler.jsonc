{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "event-every-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-02",

  // See the app's wrangler.jsonc: global_fetch_strictly_public is what makes
  // this Worker's calls to eventevery.com go out and come back in through the
  // app's own routing, instead of being short-circuited inside the account.
  // Without it every API call from here returns 404 while the identical request
  // from a laptop works, and nothing is logged as an error because nothing
  // errored - the app really did answer 404.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "observability": { "enabled": true },

  // Deliberately a SEPARATE Worker from the app. The app's entry point is
  // generated by OpenNext, which owns the default export that OAuthProvider
  // needs here - and keeping them apart means a bad MCP deploy can never take
  // eventevery.com down.
  //
  // It keeps its workers.dev hostname rather than hiding behind a custom
  // domain, because the OAuth callback URL has to resolve for every client and
  // a custom domain needs the Workers Routes zone permission first.
  "workers_dev": true,

  "kv_namespaces": [
    {
      // Required by @cloudflare/workers-oauth-provider for clients, grants and
      // tokens, and for the short-lived authorize state.
      //
      // The namespace is titled EVENT_EVERY_OAUTH while the binding keeps the
      // generic name. Titles are account-wide, and two apps sharing an OAuth
      // namespace would share registered clients and issued tokens. Green Light
      // and Meet Time name theirs the same way.
      "binding": "OAUTH_KV",
      "id": "00f0d0d9cf584f5eafd0a7673d1a2b74"
    }
  ],

  "vars": {
    // Every read and write goes through the app, so this Worker holds no
    // database binding and no encryption key at all.
    "APP_ORIGIN": "https://eventevery.com"
  }

  // Secret, set with `wrangler secret put MCP_GRANT_SECRET` on BOTH this Worker
  // and the app, with the SAME value: it is what lets this Worker trust the
  // app's assertion of who signed in. If they differ, every sign-in is refused
  // at /callback and the message deliberately does not say why.
}
