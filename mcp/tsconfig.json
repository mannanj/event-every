{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types", "bun-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  // The grant module is imported from the app rather than copied, so the app's
  // file is inside this program. One definition of what a valid grant is.
  "include": ["src/**/*.ts", "../src/server/mcp/grant.ts"]
}
