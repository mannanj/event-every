# C1-B uses synthetic values only. Real values are inputs to the later deployment
# gate and must never be placed in this file, wrangler.jsonc, tests, or build output.
OPENROUTER_OWNER_KEY=
PROVIDER_REQUEST_HMAC_CURRENT=

# Optional rotation pair. Leave both empty unless the later deployment gate is
# explicitly rotating away from the current request-shape key.
PROVIDER_REQUEST_HMAC_PREVIOUS=

# The checked-in, non-secret labels live in wrangler.jsonc:
# PROVIDER_POLICY_VERSION=owner-v1
# PROVIDER_REQUEST_HMAC_CURRENT_VERSION=c1-b-current-v1
# PROVIDER_REQUEST_HMAC_PREVIOUS_VERSION=
