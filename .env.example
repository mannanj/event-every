# Event Every owns the OpenRouter credential, base URL, rate/budget policy, and transport.
# Scanner fixes text/link to deepseek/deepseek-v4-flash and vision to
# mistralai/mistral-small-2603; callers cannot override those model IDs.
OPENROUTER_COMMUNITY_KEY=your_community_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Host-side URL detection only. This does not configure Scanner.
OPENROUTER_MODEL=mistralai/mistral-large-2512

# Upstash Redis (Rate Limiting)
# Previously Vercel KV — uses same env vars for backward compatibility
# KV_REST_API_URL=<your-upstash-url>
# KV_REST_API_TOKEN=<your-upstash-token>
# Lightweight model for the 2-3 word Recent-summons card labels (fast/cheap).
# Use the dated id; the bare `mistralai/ministral-8b` alias 404s.
OPENROUTER_SUMMARY_MODEL=mistralai/ministral-8b-2512

# --- Community access ---
# Shared daily budget (USD, resets midnight UTC) for community usage.
DAILY_BUDGET_USD=5
# The dedicated community key is required and never falls back to another key.
# Recommended: create it with a $5 credit limit + daily reset on OpenRouter as a
# hard upstream backstop (see docs/cost-analysis.md).

# --- Spirit & Hammer waitlist (Cloudflare D1) ---
# Preferred: the Worker proxy (workers/waitlist-d1-proxy) — D1 binding scoped to
# the one database, no account-wide token needed. Deploy with `wrangler deploy`,
# set its secret with `wrangler secret put PROXY_SECRET`.
# WAITLIST_D1_PROXY_URL=https://spirit-hammer-waitlist-proxy.<subdomain>.workers.dev
# WAITLIST_D1_PROXY_SECRET=
# Fallback: Cloudflare REST API with a D1-Edit token.
# CLOUDFLARE_ACCOUNT_ID=<account id>
# CLOUDFLARE_D1_DATABASE_ID=<database uuid>
# CLOUDFLARE_D1_API_TOKEN=

# OpenRouter Management key (openrouter.ai/settings/management-keys) — only
# needed to mint/rotate the community key programmatically.
# OPENROUTER_MANAGEMENT_KEY=

# --- Resend (waitlist confirmation emails) ---
# RESEND_API_KEY=
# Must use a domain verified in Resend; onboarding@resend.dev only delivers to
# the Resend account owner.
# RESEND_FROM=Spirit & Hammer <waitlist@yourdomain.com>
